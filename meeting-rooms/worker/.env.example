# Copy this file to .env (same directory) and fill in real values.
# The .env file is gitignored — do NOT commit secrets.

# Supabase project URL (e.g. https://abcdefghij.supabase.co)
SUPABASE_URL=

# Service role key — gives the worker full DB access (bypasses RLS).
# Find it at: Supabase dashboard → Project Settings → API → service_role
# Treat it like a password. Never commit, never put in client code.
SUPABASE_SERVICE_KEY=

# Where the Ollama HTTP server is listening. Default install on Windows:
#   http://localhost:11434
# The worker calls Ollama at this URL — no tunnel needed because the
# worker runs on the same machine.
OLLAMA_BASE_URL=http://localhost:11434

# Which model to use. Recommended: qwen2.5:14b (best Thai support among
# the open models at this size). Other options: qwen2.5:7b (lighter,
# faster), llama3.1:8b (weaker Thai), gemma2:9b.
OLLAMA_MODEL=qwen2.5:14b

# How often to poll the job table when idle (milliseconds).
# 10 seconds is the default — small enough that the UI feels responsive,
# big enough that it doesn't hammer Supabase.
WORKER_POLL_MS=10000

# How long to wait for Ollama to respond to a single chunk (milliseconds).
# 14b on CPU can take 60-180s for a long chunk; bump if you see timeouts.
OLLAMA_TIMEOUT_MS=240000

# --- Speech-to-text (audio attachments) ------------------------------------
# Audio files (mp3/wav/m4a/…) are transcribed locally with whisper.cpp before
# summarizing. All of these are OPTIONAL — the defaults point at the bundled
# binary + model under ./stt/, and ffmpeg is expected on PATH. Set them only
# to override.
#
# WHISPER_CLI=./stt/Release/whisper-cli.exe
# WHISPER_MODEL=./stt/ggml-large-v3-turbo-q5_0.bin
# WHISPER_VAD_MODEL=./stt/ggml-silero-v5.1.2.bin   # VAD: skips music/silence so whisper doesn't hallucinate on it
# FFMPEG_PATH=ffmpeg
# WHISPER_LANG=th
# WHISPER_THREADS=        # default: (CPU cores - 2)
# STT_TIMEOUT_MS=10800000  # 3h ceiling per audio file (covers ~2h recordings)
